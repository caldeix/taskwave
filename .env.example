# Configuración web de Firebase. Copia este fichero como `.env` y rellena los valores con los de
# la consola de Firebase (Configuración del proyecto > Tus apps > Configuración del SDK).
# `.env` no se versiona.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de sitio de reCAPTCHA v3 para App Check (vacía = sin App Check)
VITE_APPCHECK_SITE_KEY=
# Solo en desarrollo: token de depuración registrado en Firebase > App Check (opcional)
VITE_APPCHECK_DEBUG_TOKEN=
