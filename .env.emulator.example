# Modo emulador (`npm run dev:emu`). Copia este fichero como `.env.emulator`.
# El proyecto `demo-taskwave` no existe en Google: nada sale del equipo ni gasta cuota.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-taskwave
VITE_FIREBASE_AUTH_DOMAIN=demo-taskwave.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-taskwave.appspot.com
