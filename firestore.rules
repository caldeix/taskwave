rules_version = '2';

// Reglas provisionales: lo deniegan todo, igual que la base de datos de producción recién creada.
// Las reglas de verdad (propiedad, estado, admin y validación) llegan en el step-6, con sus tests.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
